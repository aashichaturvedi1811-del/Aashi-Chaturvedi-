#include <iostream>
using namespace std;

#define MAX 5

int queue[MAX];
int front = -1;
int rear = -1;

// Enqueue
void enqueue(int value) {
    if ((rear + 1) % MAX == front) {
        cout << "Queue Overflow" << endl;
    }
    else if (front == -1) {
        front = rear = 0;
        queue[rear] = value;
    }
    else {
        rear = (rear + 1) % MAX;
        queue[rear] = value;
    }
}

// Dequeue
void dequeue() {
    if (front == -1) {
        cout << "Queue Underflow" << endl;
    }
    else if (front == rear) {
        cout << queue[front] << " deleted" << endl;
        front = rear = -1;
    }
    else {
        cout << queue[front] << " deleted" << endl;
        front = (front + 1) % MAX;
    }
}

// Display
void display() {
    if (front == -1) {
        cout << "Queue is empty" << endl;
        return;
    }

    cout << "Circular Queue: ";

    int i = front;

    while (true) {
        cout << queue[i] << " ";

        if (i == rear)
            break;

        i = (i + 1) % MAX;
    }

    cout << endl;
}

int main() {

    enqueue(10);
    enqueue(20);
    enqueue(30);
    enqueue(40);
    enqueue(50);

    display();

    dequeue();
    dequeue();

    enqueue(60);
    enqueue(70);

    display();

    return 0;
}
