#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

#define MAX 100

class Stack
{
    char stack[MAX];
    int top;

public:

    Stack()
    {
        top = -1;
    }

    void push(char x)
    {
        if (top == MAX - 1)
        {
            cout << "Stack Overflow";
        }
        else
        {
            top++;
            stack[top] = x;
        }
    }

    char pop()
    {
        if (top == -1)
        {
            return '\0';
        }
        else
        {
            return stack[top--];
        }
    }

    char peek()
    {
        if (top == -1)
            return '\0';

        return stack[top];
    }

    bool isEmpty()
    {
        return top == -1;
    }
};

