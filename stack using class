#include <iostream>
using namespace std;

#define MAX 5

class Stack 
{
       int stack[MAX];
       int top = -1;

public:

void push(int x)
{
    if(top == MAX - 1)
    cout<<"stack overflow\n";
    else{
        top++;
        stack[top] = x;
    }
}

void pop()
{
    if (top == -1)
         cout<<"underlow\n";
        else 
        top--;
        }
        
};

int main() 
{
    Stack s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.pop();
    s.push(40);
   
   return 0;
}
